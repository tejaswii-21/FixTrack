# FixTrack environment configuration
#
# Copy this file to ".env" and fill in your Supabase project's public keys.
# These values are safe to expose to the browser (they are the "publishable"
# / anon key). The Supabase client uses them together with Row Level Security
# to protect data.
#
# IMPORTANT: NEVER put the Supabase service role key in a VITE_ variable.
# The service role key bypasses RLS and must only ever be used inside
# Supabase Edge Functions (server-side). It is intentionally NOT listed here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
